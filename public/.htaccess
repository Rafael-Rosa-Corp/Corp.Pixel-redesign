# =========================================================
# Configuração para hospedagem Apache/LiteSpeed (ex.: Hostinger).
# Vai junto com o site no build (dist/.htaccess). Na Vercel é ignorado.
# =========================================================

# Página de erro: endereço que não existe mostra o quebra-cabeça
ErrorDocument 404 /404.html

# Arquivos com nome "carimbado" (pasta /assets) podem ficar 1 ano no cache
<IfModule mod_headers.c>
  <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
